{
  "name": "tab-reaper",
  "private": true,
  "version": "1.0.0",
  "description": "Automatically closes idle tabs, freeing up clutter and helping you stay focused on what matters most.",
  "source": "src/manifest.json",
  "type": "module",
  "browserslist": "> 0.5%, last 2 versions, not dead",
  "scripts": {
    "build": "vite build",
    "build:safari:macos": "node scripts/safari/build-macos-payload.mjs",
    "lint": "npx @biomejs/biome ci ./src ./tests --config-path=./",
    "lint:fix": "npx @biomejs/biome check ./src ./tests --apply --config-path=./",
    "package:chrome": "pnpm build && node scripts/store/package-chrome.mjs",
    "prebuild": "rimraf dist",
    "pretest:e2e": "pnpm build",
    "start": "vite",
    "store:chrome": "pnpm build && node scripts/store/chrome-screenshots.mjs",
    "test:safari:build": "vitest --config vitest.config.ts --run scripts/safari",
    "verify:safari:macos": "node scripts/safari/verify-macos-payload.mjs",
    "test:e2e": "npx playwright test",
    "test:unit": "vitest src",
    "test:unit:ci": "vitest --run src",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "Vladislav Bulyukhin <vladislav.bulyukhin@gmail.com>",
  "license": "MPL-2.0",
  "devDependencies": {
    "@biomejs/biome": "1.6.2",
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@playwright/test": "1.58.0",
    "@types/chrome": "^0.0.235",
    "@types/node": "^20.11.30",
    "@types/react": "^18.2.73",
    "@types/react-dom": "^18.2.23",
    "@typescript-eslint/eslint-plugin": "^5.59.5",
    "@vitejs/plugin-react-swc": "^3.6.0",
    "acorn": "8.15.0",
    "autoprefixer": "^10.4.19",
    "eslint-plugin-prettier": "^4.2.1",
    "postcss": "^8.4.24",
    "rimraf": "^5.0.1",
    "tailwindcss": "^3.3.2",
    "typescript": "5.9.3",
    "vite": "^4.5.5",
    "vite-tsconfig-paths": "^4.2.1",
    "vitest": "^0.34.6",
    "vitest-mock-extended": "^1.3.1",
    "web-ext-types": "^3.2.1"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.4",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-scroll-area": "^1.0.5",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-toggle": "^1.0.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "lucide-react": "^0.363.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.51.2",
    "react-router-dom": "^6.23.0",
    "tailwind-merge": "^2.2.2",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.22.4"
  },
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e"
}
